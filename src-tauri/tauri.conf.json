{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeekWaves",
  "version": "0.1.0",
  "identifier": "com.geekwaves.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/app.jar",
      "resources/webapp/**/*",
      "resources/runtime/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
